NODE_ENV=development
PORT=5000

DATABASE_URL=postgresql://medverify_user:your_password@localhost:5432/medverify?schema=public
REDIS_URL=rediss://default:your_upstash_password@your-upstash-host:6379

JWT_SECRET=change_this_to_a_long_random_secret
REFRESH_JWT_SECRET=change_this_to_another_long_random_secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
# Used to hash verification codes at rest.
VERIFICATION_CODE_SECRET=change_this_to_a_third_long_random_secret
# Test-only toggle. Keep false in dev/staging/production.
ALLOW_TEST_CODE_PLAINTEXT=false

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
