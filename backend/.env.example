# =============================================================================
# MedVerify Backend — environment template
# =============================================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in real values (share secrets with teammates via password manager,
#    not git). Never commit .env.
# 3. Restart `npm run dev` after changes.
# =============================================================================

NODE_ENV=development
PORT=5000

# PostgreSQL (local example — adjust user/password/db name)
DATABASE_URL=postgresql://medverify_user:your_password@localhost:5432/medverify?schema=public

# Redis — pick ONE:
#   Local:  redis://127.0.0.1:6379
#   Upstash / TLS: rediss://default:your_password@your-host:6379
REDIS_URL=redis://127.0.0.1:6379

# Auth — use long random strings; JWT and REFRESH must be DIFFERENT
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars
REFRESH_JWT_SECRET=change_this_to_another_long_random_secret_min_32_chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Hashes verification codes (MV-) and activation OTP material at rest
VERIFICATION_CODE_SECRET=change_this_to_a_third_long_random_secret

# Test suite only — keep false for normal dev (tests override in tests/setup.ts)
ALLOW_TEST_CODE_PLAINTEXT=false

# Dev/staging: show corper activation OTP in API response + server log
# REQUIRED for /corper/login testing without SMS. Must be false in production.
ALLOW_DEV_OTP_PLAINTEXT=true

# Comma-separated frontend origins (add every Vite port your team uses)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# -----------------------------------------------------------------------------
# Lagos bulk seed only (npm run prisma:seed:lagos) — not read by the API server
# -----------------------------------------------------------------------------
# LAGOS_CORPER_COUNT=1000
# LAGOS_CORPER_YEAR=2026
# LAGOS_CORPER_PURGE=false
